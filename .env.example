# Do NOT commit .env to version control.

# Optional Traefik toggle used by deploy/deploy.sh
# true = include Traefik stack + dashboard Traefik override
# false = deploy AMP + dashboard without Traefik
USE_TRAEFIK=false

# Optional deploy scope toggle used by deploy/deploy.sh
# all = deploy AMP + amp-dashboard (default)
# amp = only deploy the AMP stack
# dashboard = only deploy the amp-dashboard stack
# Can also be set per-invocation with --amp-only / --dashboard-only
DEPLOY_TARGET=all

# Optional compose path overrides (only if server layout differs)
# AMP_COMPOSE=/opt/amp/deploy/amp/docker-compose.yml
# DASH_COMPOSE=/opt/amp/deploy/amp-dashboard/docker-compose.yml
# DASH_TRAEFIK_OVERRIDE=/opt/amp/deploy/amp-dashboard/docker-compose.traefik.yml
# TRAEFIK_COMPOSE=/opt/amp/deploy/traefik/docker-compose.yml

# AMP
# Docker image produced by the AMP Dockerfile build / CI pipeline
AMP_IMAGE=798366298150.dkr.ecr.us-east-1.amazonaws.com/amp/webapp
AMP_TAG=develop
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Public hostname Traefik routes to the AMP app (matched against Host header)
AMP_DOMAIN=amp.cdip.ampsite.net

# PostgreSQL credentials for the AMP database
AMP_DB_NAME=amp
AMP_DB_USER=amp
AMP_DB_PASSWORD=amp122006
# Optional overrides when running bundled AMP DB service
AMP_DB_HOST=amp-db
AMP_DB_PORT=5432
# AMP_DB_IMAGE=postgis/postgis:14-3.4

# Optional restore file path (absolute path or relative to deploy/)
# If unset, AMP DB restore is skipped.
# AMP_DB_BACKUP_FILE=backup.sql

# Force restore even when DB already has tables.
FORCE_AMP_DB_RESTORE=false

# Value written to DG_SITE_DOMAIN.site_domain after DB restore/start.
# Use the exact browser URL host users will access.
AMP_SITE_DOMAIN=amp.cdip.ampsite.net

# Tomcat JVM heap (e.g. 8g for a 16 GB instance)
AMP_JVM_HEAP=4g

# SMTP relay for AMP outbound mail
SMTP_HOST=smtp.developmentgateway.org
SMTP_FROM=noreply@developmentgateway.org

# Dashboard
# Docker image registry / tag used by the dashboard project
REPO=registry.developmentgateway.org/giz_senegal-dashboard
DASHBOARD_TAG=main-testing

# Optional alternative image var (supported by deploy/deploy.sh for registry detection)
# DASHBOARD_IMAGE=registry.developmentgateway.org/giz_senegal-dashboard

DASHBOARD_REGISTRY_USER=
DASHBOARD_REGISTRY_PASSWORD=

# Public hostname Traefik routes to the Dashboard nginx
DASHBOARD_DOMAIN=dashboard.cdip.ampsite.net

# PostgreSQL password (used by dashboard Spring Boot services)
DASHBOARD_DB_PASSWORD=admin

# Optional dashboard postgres restore dump (absolute path or relative to deploy/)
# If unset, dashboard postgres restore is skipped.
# DASHBOARD_POSTGRES_BACKUP_FILE=dashboard-postgres.sql
FORCE_DASHBOARD_POSTGRES_RESTORE=false

# Optional dashboard mysql restore dump (absolute path or relative to deploy/)
# If unset, dashboard mysql restore is skipped.
# DASHBOARD_MYSQL_BACKUP_FILE=dashboard-mysql.sql
# Optional explicit credentials for dashboard MySQL restore.
# If unset, script uses DASHBOARD_MYSQL_WP_USER/DASHBOARD_MYSQL_WP_PASSWORD and DB=wordpress.
# DASHBOARD_MYSQL_RESTORE_USER=wordpress
# DASHBOARD_MYSQL_RESTORE_PASSWORD=
# DASHBOARD_MYSQL_RESTORE_DB=wordpress
FORCE_DASHBOARD_MYSQL_RESTORE=false

# Optional uploads source (directory, .tar.gz, .tgz, .tar) for WordPress uploads
# If unset, dashboard uploads restore is skipped.
# DASHBOARD_UPLOADS_SOURCE=uploads.tar.gz
FORCE_DASHBOARD_UPLOADS_RESTORE=false

# Optional for non-interactive runs (CI/cron): auto-approve all configured restores.
ASSUME_YES_RESTORE=false

# MySQL passwords (WordPress)
# DASHBOARD_MYSQL_WP_USER defaults to wordpress when unset
# DASHBOARD_MYSQL_DB_NAME defaults to wordpress when unset
# DASHBOARD_MYSQL_WP_USER=wordpress
# DASHBOARD_MYSQL_DB_NAME=wordpress
DASHBOARD_MYSQL_WP_PASSWORD=wordpress
DASHBOARD_MYSQL_ROOT_PASSWORD=wordpress
